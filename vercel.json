{
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/v1/).*\\.[a-zA-Z0-9]+)$",
      "destination": "/dist/$1"
    },
    {
      "source": "/((?!api/v1/).*)",
      "destination": "/dist/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "frontend/**"
    }
  }
}
